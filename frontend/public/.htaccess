# Lifety Solar Intelligence (re100life.com)
# Apache Web Hosting Rewrite Rules & SSL Enforcer

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 🌟 대표님 요청: SSL 항상 사용 (HTTP -> HTTPS 301 영구 강제 리다이렉트)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. SPA (Single Page Application) HTML5 History PushState 지원
  # 파일이나 디렉터리가 실제로 존재하지 않는 경우 항상 index.html로 포워딩 (새로고침 404 방지)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 보안 헤더 기본 설정
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
